# ============================================
# UpahJe.my - Environment Variables
# ============================================
# Copy this file to .env.local for local development
# For Vercel, add these variables in the Vercel dashboard
# ============================================

# ============================================
# Supabase Configuration
# ============================================
# Get these from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Alternative key name (some Supabase versions use this)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role key for server-side operations (keep secret!)
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# Database Configuration (Prisma)
# ============================================
# Connection string for PostgreSQL database
# Format: postgresql://postgres:***@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# Direct connection URL for Prisma migrations (optional, same as DATABASE_URL for Supabase)
DIRECT_URL=

# ============================================
# Supabase Auth Configuration
# ============================================
# Set to 'production' in Vercel
NODE_ENV=production

# Site URL for auth redirects (update for your domain)
SITE_URL=https://upahje.my

# ============================================
# NextAuth Configuration
# ============================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Production domain (update for your domain)
NEXTAUTH_URL=https://upahje.my

# ============================================
# Payment Gateway - Billplz (Malaysian FPX)
# ============================================
# Get these from Billplz Dashboard
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_X_SIGNATURE_KEY=
BILLPLZ_SANDBOX=false

# ============================================
# Additional Configuration
# ============================================
# Set to 'production' in Vercel
NODE_ENV=production
