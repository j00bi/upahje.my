generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  image           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  accounts        Account[]
  employer        Employer?
  profile         Profile?
  reviewsWritten  Review[]  @relation("ReviewFromUser")
  reviewsReceived Review[]  @relation("ReviewToUser")
  sessions        Session[]
  talent          Talent?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  role      Role     @default(TALENT)
  phone     String?
  state     String?
  area      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Talent {
  id                 String              @id @default(cuid())
  userId             String              @unique
  track              Track
  bio                String?
  rate               String?
  availability       String?
  kycTier            Int                 @default(0)
  verified           Boolean             @default(false)
  createdAt          DateTime            @default(now())
  escrowTransactions EscrowTransaction[]
  jobs               Job[]
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories         TalentCategory[]
}

model TalentCategory {
  talentId   String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  talent     Talent   @relation(fields: [talentId], references: [id])

  @@id([talentId, categoryId])
}

model Employer {
  id                 String              @id @default(cuid())
  userId             String              @unique
  company            String?
  createdAt          DateTime            @default(now())
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  escrowTransactions EscrowTransaction[]
  jobs               Job[]
}

model Category {
  id      String           @id @default(cuid())
  name    String           @unique
  track   Track
  emoji   String?
  jobs    Job[]
  talents TalentCategory[]
}

model Job {
  id                 String              @id @default(cuid())
  title              String
  description        String?
  track              Track
  rate               String?
  location           String?
  status             JobStatus           @default(OPEN)
  employerId         String
  talentId           String?
  createdAt          DateTime            @default(now())
  categoryId         String
  escrowTransactions EscrowTransaction[]
  category           Category            @relation(fields: [categoryId], references: [id])
  employer           Employer            @relation(fields: [employerId], references: [id])
  talent             Talent?             @relation(fields: [talentId], references: [id])
  payments           Payment[]
}

model Review {
  id         String   @id @default(cuid())
  jobId      String   @unique
  rating     Int
  comment    String?
  fromUserId String
  toUserId   String
  createdAt  DateTime @default(now())
  fromUser   User     @relation("ReviewFromUser", fields: [fromUserId], references: [id])
  toUser     User     @relation("ReviewToUser", fields: [toUserId], references: [id])
}

model EscrowTransaction {
  id                   String       @id @default(cuid())
  jobId                String
  amount               Float
  status               EscrowStatus @default(HELD)
  employerId           String
  talentId             String
  billplzTransactionId String?
  createdAt            DateTime     @default(now())
  releasedAt           DateTime?
  cancelledAt          DateTime?
  employer             Employer     @relation(fields: [employerId], references: [id])
  job                  Job          @relation(fields: [jobId], references: [id])
  talent               Talent       @relation(fields: [talentId], references: [id])

  @@index([jobId])
  @@index([employerId])
  @@index([talentId])
}

model Payment {
  id            String    @id @default(cuid())
  jobId         String
  amount        Float
  status        String
  employerEmail String
  talentEmail   String
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  job           Job       @relation(fields: [jobId], references: [id])

  @@index([jobId])
}

enum Role {
  TALENT
  EMPLOYER
  ADMIN
}

enum Track {
  LABOUR
  TECHNICAL
}

enum JobStatus {
  OPEN
  MATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EscrowStatus {
  HELD
  RELEASED
  CANCELLED
}

enum ArticleType {
  explainer
  guide
  comparison
  perspective
}

model Author {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  bio       String?
  avatarUrl String?
  createdAt DateTime  @default(now())
  articles  Article[]

  @@map("authors")
}

/// The six editorial pillars. Existing URL categories stay with the content
/// reader; this table is the structured model and stays hidden until a pillar
/// has three live pieces.
model EditorialCategory {
  id            String    @id @default(cuid())
  slug          String    @unique
  nameEn        String
  nameMs        String
  descriptionEn String?
  descriptionMs String?
  sortOrder     Int       @default(0)
  hidden        Boolean   @default(false)
  primaryOf     Article[] @relation("PrimaryCategory")
  secondaryOf   Article[] @relation("SecondaryCategory")

  @@map("categories")
}

model Collection {
  id            String   @id @default(cuid())
  slug          String   @unique
  titleEn       String
  titleMs       String
  descriptionEn String?
  descriptionMs String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  @@map("collections")
}

model Article {
  id                  String               @id @default(cuid())
  translationKey      String               @unique
  type                ArticleType
  primaryCategoryId   String
  secondaryCategoryId String?
  authorId            String?
  publishedAt         DateTime?
  updatedAt           DateTime?
  draft               Boolean              @default(false)
  createdAt           DateTime             @default(now())
  primaryCategory     EditorialCategory    @relation("PrimaryCategory", fields: [primaryCategoryId], references: [id])
  secondaryCategory   EditorialCategory?   @relation("SecondaryCategory", fields: [secondaryCategoryId], references: [id])
  author              Author?              @relation(fields: [authorId], references: [id])
  translations        ArticleTranslation[]

  @@map("articles")
}

model ArticleTranslation {
  id             String          @id @default(cuid())
  articleId      String
  lang           String
  slug           String
  title          String
  description    String
  bodyMarkdown   String
  paragraphCount Int
  readingMinutes Int
  canonicalUrl   String?
  article        Article         @relation(fields: [articleId], references: [id], onDelete: Cascade)
  sources        ArticleSource[]
  figures        ArticleFigure[]

  @@unique([articleId, lang])
  @@unique([lang, slug])
  @@map("article_translations")
}

model ArticleSource {
  id            String             @id @default(cuid())
  translationId String
  position      Int
  title         String
  url           String
  checkedAt     DateTime?
  translation   ArticleTranslation @relation(fields: [translationId], references: [id], onDelete: Cascade)

  @@unique([translationId, position])
  @@map("article_sources")
}

model ArticleFigure {
  id            String             @id @default(cuid())
  translationId String
  position      Int
  src           String
  alt           String
  caption       String?
  width         Int?
  height        Int?
  translation   ArticleTranslation @relation(fields: [translationId], references: [id], onDelete: Cascade)

  @@unique([translationId, position])
  @@map("article_figures")
}
