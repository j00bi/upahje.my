// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  accounts        Account[]
  sessions        Session[]
  profile         Profile?
  talent          Talent?
  employer        Employer?
  reviewsWritten  Review[]  @relation("ReviewFromUser")
  reviewsReceived Review[]  @relation("ReviewToUser")

  @@index([email])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  role      Role     @default(TALENT)
  phone     String?
  state     String?
  area      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([role])
  @@index([userId])
}

enum Role {
  TALENT
  EMPLOYER
  ADMIN
}

model Talent {
  id           String   @id @default(cuid())
  userId       String   @unique
  track        Track
  bio          String?
  rate         String?
  availability String?
  kycTier      Int      @default(0)
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories         TalentCategory[]
  jobs               Job[]
  escrowTransactions EscrowTransaction[]

  @@index([track])
  @@index([verified])
  @@index([kycTier])
  @@index([createdAt])
}

enum Track {
  LABOUR
  TECHNICAL
}

model TalentCategory {
  talentId   String
  categoryId String
  talent     Talent   @relation(fields: [talentId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([talentId, categoryId])
  @@index([categoryId])
}

model Employer {
  id        String   @id @default(cuid())
  userId    String   @unique
  company   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs               Job[]
  escrowTransactions EscrowTransaction[]

  @@index([userId])
  @@index([createdAt])
}

model Category {
  id      String           @id @default(cuid())
  name    String           @unique
  track   Track
  emoji   String?
  talents TalentCategory[]
  jobs    Job[]

  @@index([track])
}

model Job {
  id          String    @id @default(cuid())
  title       String
  description String?
  track       Track
  rate        String?
  location    String?
  status      JobStatus @default(OPEN)
  employerId  String
  talentId    String?
  categoryId  String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  employer           Employer            @relation(fields: [employerId], references: [id])
  talent             Talent?             @relation(fields: [talentId], references: [id])
  category           Category            @relation(fields: [categoryId], references: [id])
  escrowTransactions EscrowTransaction[]
  payments           Payment[]
  applications       Application[]

  @@index([employerId])
  @@index([talentId])
  @@index([categoryId])
  @@index([status])
  @@index([track])
  @@index([createdAt])
}

enum JobStatus {
  OPEN
  MATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Review {
  id         String   @id @default(cuid())
  jobId      String   @unique
  rating     Int
  comment    String?
  fromUserId String
  toUserId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  fromUser User @relation("ReviewFromUser", fields: [fromUserId], references: [id])
  toUser   User @relation("ReviewToUser", fields: [toUserId], references: [id])

  @@index([fromUserId])
  @@index([toUserId])
  @@index([rating])
  @@index([createdAt])
}

model EscrowTransaction {
  id                   String       @id @default(cuid())
  jobId                String
  amount               Float
  status               EscrowStatus @default(HELD)
  employerId           String
  talentId             String
  billplzTransactionId String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  releasedAt           DateTime?
  cancelledAt          DateTime?
  deletedAt            DateTime?

  job      Job      @relation(fields: [jobId], references: [id])
  employer Employer @relation(fields: [employerId], references: [id])
  talent   Talent   @relation(fields: [talentId], references: [id])

  @@index([jobId])
  @@index([employerId])
  @@index([talentId])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id            String    @id @default(cuid())
  jobId         String
  amount        Float
  status        String
  employerEmail String
  talentEmail   String
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  job Job @relation(fields: [jobId], references: [id])

  @@index([jobId])
  @@index([status])
  @@index([createdAt])
}

model Application {
  id          String   @id @default(cuid())
  jobId       String
  applicantId String
  message     String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  job Job @relation(fields: [jobId], references: [id])

  @@index([jobId])
  @@index([applicantId])
  @@index([status])
}

enum EscrowStatus {
  HELD
  RELEASED
  CANCELLED
}

// ============================================================
// UpahJe.Ai — Agent API POC v0.2 models
// Added: 2026-05-19 (Grok - Thin Agent API + Mem0 quadrant)
// These models power autonomous AI agent registration, task
// discovery, execution, and full audit trail (LifecycleEvent).
// Intentionally separate from human Job/Talent models for POC safety.
// Run: npx prisma migrate dev --name add_agent_api_poc_models
// ============================================================

model Agent {
  id             String   @id @default(cuid())
  name           String   @unique
  email          String?
  apiKeyHash     String   // one-way hash of the secret key (shown once on register)
  capabilities   String[] // e.g. ["web:scrape:http", "lang:en,ms", "gen:image"]
  rate           Json?    // { amount: 45, unit: "per_task" | "per_hour" }
  maxConcurrent  Int      @default(1)
  trustLevel     String   @default("new") // new | verified | trusted | high_volume
  successRate    Float    @default(0.0)
  totalCompleted Int      @default(0)
  ghostingCount  Int      @default(0)
  createdAt      DateTime @default(now())
  lastActiveAt   DateTime @updatedAt

  submissions     AgentSubmission[]
  lifecycleEvents LifecycleEvent[]
  matchedTasks    AiTask[]
}

model AiTask {
  id                   String   @id @default(cuid())
  title                String
  description          String?
  category             String
  requiredCapabilities String[]
  reward               Json     // { amount: 200, currency: "MYR" }
  difficulty           String   // easy | medium | hard
  status               String   @default("open") // open | matched | in_progress | submitted | under_review | completed | cancelled
  postedByUserId       String?
  matchedAgentId       String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  matchedAgent    Agent?            @relation(fields: [matchedAgentId], references: [id])
  submissions     AgentSubmission[]
  lifecycleEvents LifecycleEvent[]
}

model AgentSubmission {
  id              String   @id @default(cuid())
  taskId          String
  agentId         String
  artifacts       Json     // [{ type: "url"|"text"|"file", value: "...", mime?: "..." }]
  notes           String?
  completionProof Json?
  submittedAt     DateTime @default(now())
  review          Json?    // { rating, comment, reviewedAt }

  task  AiTask @relation(fields: [taskId], references: [id])
  agent Agent  @relation(fields: [agentId], references: [id])
}

model LifecycleEvent {
  id        String   @id @default(cuid())
  taskId    String?
  agentId   String?
  type      String   // "agent.registered", "task.posted", "agent.accepted", "work.submitted", "review.completed", ...
  payload   Json
  actor     String   // "owner" | "agent" | "system" | "admin"
  timestamp DateTime @default(now())

  task  AiTask? @relation(fields: [taskId], references: [id])
  agent Agent?  @relation(fields: [agentId], references: [id])
}
