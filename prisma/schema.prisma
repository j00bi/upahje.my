// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  accounts        Account[]
  sessions        Session[]
  profile         Profile?
  talent          Talent?
  employer        Employer?
  reviewsWritten  Review[]  @relation("ReviewFromUser")
  reviewsReceived Review[]  @relation("ReviewToUser")

  @@index([email])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  role      Role     @default(TALENT)
  phone     String?
  state     String?
  area      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([role])
  @@index([userId])
}

enum Role {
  TALENT
  EMPLOYER
  ADMIN
}

model Talent {
  id           String   @id @default(cuid())
  userId       String   @unique
  track        Track
  bio          String?
  rate         String?
  availability String?
  kycTier      Int      @default(0)
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories         TalentCategory[]
  jobs               Job[]
  escrowTransactions EscrowTransaction[]

  @@index([track])
  @@index([verified])
  @@index([kycTier])
  @@index([createdAt])
}

enum Track {
  LABOUR
  TECHNICAL
}

model TalentCategory {
  talentId   String
  categoryId String
  talent     Talent   @relation(fields: [talentId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([talentId, categoryId])
  @@index([categoryId])
}

model Employer {
  id        String   @id @default(cuid())
  userId    String   @unique
  company   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs               Job[]
  escrowTransactions EscrowTransaction[]

  @@index([userId])
  @@index([createdAt])
}

model Category {
  id      String           @id @default(cuid())
  name    String           @unique
  track   Track
  emoji   String?
  talents TalentCategory[]
  jobs    Job[]

  @@index([track])
}

model Job {
  id          String    @id @default(cuid())
  title       String
  description String?
  track       Track
  rate        String?
  location    String?
  status      JobStatus @default(OPEN)
  employerId  String
  talentId    String?
  categoryId  String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  employer           Employer            @relation(fields: [employerId], references: [id])
  talent             Talent?             @relation(fields: [talentId], references: [id])
  category           Category            @relation(fields: [categoryId], references: [id])
  escrowTransactions EscrowTransaction[]
  payments           Payment[]
  applications       Application[]

  @@index([employerId])
  @@index([talentId])
  @@index([categoryId])
  @@index([status])
  @@index([track])
  @@index([createdAt])
}

enum JobStatus {
  OPEN
  MATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Review {
  id         String   @id @default(cuid())
  jobId      String   @unique
  rating     Int
  comment    String?
  fromUserId String
  toUserId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  fromUser User @relation("ReviewFromUser", fields: [fromUserId], references: [id])
  toUser   User @relation("ReviewToUser", fields: [toUserId], references: [id])

  @@index([fromUserId])
  @@index([toUserId])
  @@index([rating])
  @@index([createdAt])
}

model EscrowTransaction {
  id                   String       @id @default(cuid())
  jobId                String
  amount               Float
  status               EscrowStatus @default(HELD)
  employerId           String
  talentId             String
  billplzTransactionId String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  releasedAt           DateTime?
  cancelledAt          DateTime?
  deletedAt            DateTime?

  job      Job      @relation(fields: [jobId], references: [id])
  employer Employer @relation(fields: [employerId], references: [id])
  talent   Talent   @relation(fields: [talentId], references: [id])

  @@index([jobId])
  @@index([employerId])
  @@index([talentId])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id            String    @id @default(cuid())
  jobId         String
  amount        Float
  status        String
  employerEmail String
  talentEmail   String
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  job Job @relation(fields: [jobId], references: [id])

  @@index([jobId])
  @@index([status])
  @@index([createdAt])
}

model Application {
  id          String   @id @default(cuid())
  jobId       String
  applicantId String
  message     String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  job Job @relation(fields: [jobId], references: [id])

  @@index([jobId])
  @@index([applicantId])
  @@index([status])
}

enum EscrowStatus {
  HELD
  RELEASED
  CANCELLED
}
